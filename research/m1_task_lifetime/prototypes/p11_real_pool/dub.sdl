name "m1-p11-real-pool"
description "Research-only typed M0 work-stealing consumer; not a public package"
targetType "executable"
// Research fixture only: preview flags must NOT enter the published package.
dflags "-preview=dip1000"
sourcePaths "concurrency"
// Import only P09’s trait module, not its separate experimental main().
sourceFiles "../p09_transfer_contract/concurrency/research/m1_inline_transfer.d"
importPaths "." "../p09_transfer_contract"
dependency "concurrency-d" path="../../../../"

configuration "positive" {
    mainSourceFile "consumer/main.d"
}
configuration "negative-safe" {
    mainSourceFile "consumer/negative_safe.d"
}
configuration "negative-borrow" {
    mainSourceFile "consumer/negative_borrow.d"
}
configuration "negative-delegate" {
    mainSourceFile "consumer/negative_delegate.d"
}

configuration "optimized" {
    mainSourceFile "consumer/main.d"
    // Debug build retains assertions; this configuration adds LDC -O3.
    dflags "-O3"
}

configuration "owned-graph" {
    mainSourceFile "consumer/p19_owned_graph.d"
}
configuration "owned-graph-optimized" {
    mainSourceFile "consumer/p19_owned_graph.d"
    dflags "-O3"
}
configuration "owned-negative-safe" {
    mainSourceFile "consumer/p19_negative_safe.d"
}

configuration "owned-fault" {
    mainSourceFile "consumer/p20_fault_consumer.d"
}
configuration "owned-fault-optimized" {
    mainSourceFile "consumer/p20_fault_consumer.d"
    dflags "-O3"
}

configuration "p23-lifecycle" {
    mainSourceFile "consumer/p23_lifecycle.d"
}
configuration "p23-lifecycle-optimized" {
    mainSourceFile "consumer/p23_lifecycle.d"
    dflags "-O3"
}

configuration "p24-root-registry" {
    mainSourceFile "consumer/p24_root_registry.d"
}
configuration "p24-root-registry-optimized" {
    mainSourceFile "consumer/p24_root_registry.d"
    dflags "-O3"
}

configuration "p25-owner-modes" {
    mainSourceFile "consumer/p25_ownership_modes.d"
}
configuration "p25-owner-modes-optimized" {
    mainSourceFile "consumer/p25_ownership_modes.d"
    dflags "-O3"
}

configuration "p27-transitions" {
    mainSourceFile "consumer/p27_registry_transitions.d"
}
configuration "p27-transitions-optimized" {
    mainSourceFile "consumer/p27_registry_transitions.d"
    dflags "-O3"
}

configuration "p28-bounded" {
    mainSourceFile "consumer/p28_bounded_orphans.d"
}
configuration "p28-bounded-optimized" {
    mainSourceFile "consumer/p28_bounded_orphans.d"
    dflags "-O3"
}

configuration "p29-generational" {
    mainSourceFile "consumer/p29_generational_owner.d"
}
configuration "p29-generational-optimized" {
    mainSourceFile "consumer/p29_generational_owner.d"
    dflags "-O3"
}

configuration "p33-phases" {
    mainSourceFile "consumer/p33_generational_owner.d"
}

configuration "p33-phases-optimized" {
    mainSourceFile "consumer/p33_generational_owner.d"
    dflags "-O3"
}

configuration "p34-null" {
    mainSourceFile "consumer/p34_generational_owner.d"
}
configuration "p34-timed" {
    mainSourceFile "consumer/p34_generational_owner.d"
    dflags "-version=P34Timed"
}
configuration "p34-null-optimized" {
    mainSourceFile "consumer/p34_generational_owner.d"
    dflags "-O3"
}
configuration "p34-timed-optimized" {
    mainSourceFile "consumer/p34_generational_owner.d"
    dflags "-O3" "-version=P34Timed"
}

configuration "p35-null" {
    mainSourceFile "consumer/p35_generational_owner.d"
}
configuration "p35-timed" {
    mainSourceFile "consumer/p35_generational_owner.d"
    dflags "-version=P35Timed"
}
configuration "p35-null-optimized" {
    mainSourceFile "consumer/p35_generational_owner.d"
    dflags "-O3"
}
configuration "p35-timed-optimized" {
    mainSourceFile "consumer/p35_generational_owner.d"
    dflags "-O3" "-version=P35Timed"
}

configuration "p36-null" {
    mainSourceFile "consumer/p36_generational_owner.d"
}
configuration "p36-timed" {
    mainSourceFile "consumer/p36_generational_owner.d"
    dflags "-version=P36Timed"
}

configuration "p36-null-optimized" {
    mainSourceFile "consumer/p36_generational_owner.d"
    dflags "-O3"
}
configuration "p36-timed-optimized" {
    mainSourceFile "consumer/p36_generational_owner.d"
    dflags "-O3" "-version=P36Timed"
}
