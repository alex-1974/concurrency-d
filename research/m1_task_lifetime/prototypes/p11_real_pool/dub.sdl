name "m1-p11-real-pool"
description "Research-only typed M0 work-stealing consumer; not a public package"
targetType "executable"
// Research fixture only: preview flags must NOT enter the published package.
dflags "-preview=dip1000"
sourcePaths "concurrency"
// Import only P09’s trait module, not its separate experimental main().
sourceFiles "../p09_transfer_contract/concurrency/research/m1_inline_transfer.d"
importPaths "." "../p09_transfer_contract"
dependency "concurrency-d" path="../../../../"

configuration "positive" {
    mainSourceFile "consumer/main.d"
}
configuration "negative-safe" {
    mainSourceFile "consumer/negative_safe.d"
}
configuration "negative-borrow" {
    mainSourceFile "consumer/negative_borrow.d"
}
configuration "negative-delegate" {
    mainSourceFile "consumer/negative_delegate.d"
}

configuration "optimized" {
    mainSourceFile "consumer/main.d"
    // Debug build retains assertions; this configuration adds LDC -O3.
    dflags "-O3"
}

configuration "owned-graph" {
    mainSourceFile "consumer/p19_owned_graph.d"
}
configuration "owned-graph-optimized" {
    mainSourceFile "consumer/p19_owned_graph.d"
    dflags "-O3"
}
configuration "owned-negative-safe" {
    mainSourceFile "consumer/p19_negative_safe.d"
}

configuration "owned-fault" {
    mainSourceFile "consumer/p20_fault_consumer.d"
}
configuration "owned-fault-optimized" {
    mainSourceFile "consumer/p20_fault_consumer.d"
    dflags "-O3"
}

