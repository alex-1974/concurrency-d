    mainSourceFile "consumer/p42_multi_producer.d"
}

configuration "p42-multi-baseline" {
    mainSourceFile "consumer/p42_multi_producer.d"
    dflags "-version=P42Baseline"
}

configuration "p42-close-baseline" {
    mainSourceFile "consumer/p42_close_race.d"
    dflags "-version=P42Baseline"
}
configuration "p42-close-conditional" {
    mainSourceFile "consumer/p42_close_race.d"
}

configuration "p42-bench-baseline" {
    mainSourceFile "consumer/p42_benchmark.d"
    dflags "-O3" "-version=P42Baseline"
}
configuration "p42-bench-conditional" {
    mainSourceFile "consumer/p42_benchmark.d"
    dflags "-O3"
}

configuration "p42-bench-baseline-medium" {
    mainSourceFile "consumer/p42_benchmark.d"
    dflags "-version=P42Baseline" "-version=P42MediumTask"
}
configuration "p42-bench-conditional-medium" {
    mainSourceFile "consumer/p42_benchmark.d"
    dflags "-version=P42MediumTask"
}

configuration "p42-idle-baseline" {
    mainSourceFile "consumer/p42_idle_latency.d"
    versions "P42Baseline"
}
configuration "p42-idle-conditional" {
    mainSourceFile "consumer/p42_idle_latency.d"
}

configuration "p42-multi-idle-baseline" {
    mainSourceFile "consumer/p42_multi_idle.d"
    versions "P42Baseline"
}
configuration "p42-multi-idle-conditional" {
    mainSourceFile "consumer/p42_multi_idle.d"
}

# P42.17 diagnostic-only, mutually matched policy arms. Existing P42.16
# consumer/configurations remain available unchanged.
configuration "p42-flow-baseline" {
    mainSourceFile "consumer/p42_multi_idle.d"
    versions "P42Baseline" "P42Flow"
}
configuration "p42-flow-conditional" {
    mainSourceFile "consumer/p42_multi_idle.d"
    versions "P42Flow"
}

# P42.18: same established uninstrumented P42 consumer/workload in both
# policies. No diagnostic worker/TLS/timestamp/flow overlay. Build=release
# is supplied identically by the native runner; no per-arm optimization flags.
configuration "p42-e2e-baseline-light" {
    mainSourceFile "consumer/p42_benchmark.d"
    versions "P42Baseline"
}
configuration "p42-e2e-conditional-light" {
    mainSourceFile "consumer/p42_benchmark.d"
}
configuration "p42-e2e-baseline-medium" {
    mainSourceFile "consumer/p42_benchmark.d"
    versions "P42Baseline" "P42MediumTask"
}
configuration "p42-e2e-conditional-medium" {
    mainSourceFile "consumer/p42_benchmark.d"
    versions "P42MediumTask"
}

// P42.20 uses the historical minimal conditional overlay, not observed pools.
configuration "p42-return-baseline" {
    mainSourceFile "consumer/p42_return_boundary.d"
    versions "P42Baseline"
}
configuration "p42-return-conditional" {
    mainSourceFile "consumer/p42_return_boundary.d"
}
configuration "p42-return-baseline-optimized" {
    mainSourceFile "consumer/p42_return_boundary.d"
    dflags "-O3"
    versions "P42Baseline"
}
configuration "p42-return-conditional-optimized" {
    mainSourceFile "consumer/p42_return_boundary.d"
    dflags "-O3"
}
